# The PIN you type to unlock the app. Digits only, 4-10 characters recommended.
APP_PIN=482913

# Random secret used to sign login session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# 32-byte key (base64) used to encrypt your 2FA secrets at rest. Generate with:
#   openssl rand -base64 32
# Keep this separate from APP_PIN - losing it means losing access to stored accounts.
ENCRYPTION_KEY=

# Auto-provided by Vercel when you connect a Blob store to this project
# (Storage tab -> Create Database -> Blob). Not needed for local dev; a local
# encrypted file under .data/ is used instead when this is unset.
# BLOB_READ_WRITE_TOKEN=
